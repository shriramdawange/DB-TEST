{
  "name": "college-portal-backend",
  "version": "1.0.0",
  "description": "REST API for the College Students Record Portal (Node + Express + SQLite)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "express",
    "sqlite",
    "better-sqlite3",
    "students",
    "rest-api"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "better-sqlite3@12.11.1": true
  }
}
