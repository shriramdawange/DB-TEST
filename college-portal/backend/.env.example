# ---------------------------------------------------------------------------
# Copy this file to ".env" and adjust if you need to:
#   Windows (PowerShell):  copy .env.example .env
#   macOS / Linux:        cp .env.example .env
#
# Every value below already has a working default, so the app runs even if
# you never create this file. Never commit the real .env — it is git-ignored.
# ---------------------------------------------------------------------------

# Port the API server listens on
PORT=5000

# Path to the SQLite database file.
# Relative paths are resolved from the backend/ folder.
DB_FILE=./data/college_portal.db

# Set to false to skip the sample students defined in database/schema.sql
SEED_DATA=true
